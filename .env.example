# CEMP public demo configuration
CEMP_DEBUG=true
CEMP_HOST_PORT=8000
CEMP_BASE_IMAGE=quay.io/condaforge/miniforge3:23.11.0-0
CEMP_BUILD_NETWORK=host
CEMP_SECRET_KEY=change-this-local-demo-secret
CEMP_DEMO_FERNET_SEED=change-this-local-demo-fernet-seed
CEMP_SQLITE_PATH=/app/public_demo.sqlite3
CEMP_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0
CEMP_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CEMP_CORS_ALLOW_ALL_ORIGINS=true
CEMP_SITE_DOMAIN=http://localhost:8000

# Remote Docker example:
# CEMP_HOST_PORT=18080
# CEMP_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,<server-ip>
# CEMP_CSRF_TRUSTED_ORIGINS=http://localhost:18080,http://127.0.0.1:18080,http://<server-ip>:18080
# CEMP_SITE_DOMAIN=http://<server-ip>:18080

# Optional: set after extracting cemp_public_model_assets.tar.gz.
CEMP_IL_MODEL_DIR=/app/ionic_liquid/static/model

# Optional: only needed when refreshing Materials Project crystal data.
MP_API_KEY=

# Optional MySQL mode. The public demo uses SQLite by default.
CEMP_ENABLE_MYSQL=false
CEMP_MYSQL_DATABASE=cemp
CEMP_MYSQL_USER=cemp
CEMP_MYSQL_PASSWORD=
CEMP_MYSQL_HOST=127.0.0.1
CEMP_MYSQL_PORT=3306

# Optional email backend. Console backend is the public-demo default.
CEMP_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
CEMP_DEFAULT_FROM_EMAIL=CEMP Platform <noreply@localhost>
